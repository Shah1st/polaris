{
  "name": "polaris (ROS 2 Jazzy)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws,type=bind",
  "workspaceFolder": "/ws",
  "containerEnv": {
    "ROS_DOMAIN_ID": "42",
    "RCUTILS_COLORIZED_OUTPUT": "1"
  },
  // host.docker.internal = the host machine (rover mapper bridge, guidance_rover_vo). Docker
  // Desktop provides it already; this line makes it work on a Linux host too.
  // TODO: camera passthrough, e.g. add "--device=/dev/video0" on a Linux host.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "postCreateCommand": "rosdep update && rosdep install --from-paths src --ignore-src -y -r && bash -lc 'source /opt/ros/jazzy/setup.bash && colcon build --symlink-install'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-xml"
      ],
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "python.testing.pytestEnabled": true
      }
    }
  }
}
